# Development defaults (vite dev, mode "development").
#
# Committed on purpose: the dev gateway address is not a secret, and keeping it
# here lets .env.local stay reserved for personal overrides. Deploys read
# .env.production instead, so a local working copy can no longer leak
# localhost:8787 into a production bundle.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8787
NEXT_PUBLIC_APP_NAME=notio
