{
  "extends": "@notio/config/tsconfig/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "vinext-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "vitest.config.ts",
    "vite.config.ts",
    "cloudflare.config.ts",
    ".cloudflare/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
