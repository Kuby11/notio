{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "auth-service",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "vars": {
    "ENVIRONMENT": "production",
    "SERVICE_VERSION": "0.1.0",
    "BETTER_AUTH_URL": "https://notio-gateway.saab112468.workers.dev",
    "FRONTEND_URL": "https://notio-web.saab112468.workers.dev",
    "TRUSTED_ORIGINS": "https://notio-web.saab112468.workers.dev",
    "COOKIE_DOMAIN": "saab112468.workers.dev",
    "RATE_LIMIT_MAX_REQUESTS": "20",
    "RATE_LIMIT_WINDOW_SECONDS": "60",
  },
  "workers_dev": false,
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "883421eab31d4f1ab2ff35eb131e3072",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "notio-auth",
      "database_id": "a2d09447-714d-4706-97ed-7c537c08f6fc",
      "migrations_dir": "migrations",
    },
  ],
}
