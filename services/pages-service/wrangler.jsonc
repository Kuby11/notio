{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pages-service",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "vars": {
    "ENVIRONMENT": "development",
    "SERVICE_VERSION": "0.1.0",
  },
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "notio-pages",
      // Placeholder: replaced by the real id from `wrangler d1 create notio-pages`.
      // Locally (wrangler dev / vitest) the value is ignored — a local SQLite copy runs.
      "database_id": "145e3972-ffc7-456e-b59d-abadd82a97c1",
      "migrations_dir": "migrations",
    },
  ],
}
